# 로컬 개발용 예시 환경변수. 실제 값은 `.env.local`에 저장하고 커밋하지 않는다.
# 로컬 값: `supabase status` 출력으로 채운다.
# 원격(배포) 값: Supabase Dashboard + Vercel env 를 참조 (CLAUDE.md §5 참고).

# Supabase REST / Auth 엔드포인트 (브라우저 번들)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon key (브라우저 번들 OK. service role key 금지)
NEXT_PUBLIC_SUPABASE_ANON_KEY=__local_anon_key__

# Drizzle 런타임 쿼리용 Postgres 접속 문자열
# 로컬: `supabase status` 의 DB URL (54322)
# 배포: Vercel 환경변수는 Transaction pooler(6543) 사용
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
